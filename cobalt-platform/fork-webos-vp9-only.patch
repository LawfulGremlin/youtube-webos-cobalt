diff --git a/starboard/linux/shared/media_is_video_supported.cc b/starboard/linux/shared/media_is_video_supported.cc
--- a/starboard/linux/shared/media_is_video_supported.cc
+++ b/starboard/linux/shared/media_is_video_supported.cc
@@ -14,6 +14,8 @@
 
 #include "starboard/shared/starboard/media/media_support_internal.h"
 
+#include <stdio.h>
+
 #include "starboard/common/log.h"
 #include "starboard/configuration.h"
 #include "starboard/configuration_constants.h"
@@ -72,8 +74,22 @@
   // conservative, while advertising the UHD codecs confirmed by hardware
   // playback on webOS 6.5 devices. A zero dimension means "not constrained".
   const bool is_avc = video_codec == kSbMediaVideoCodecH264;
-  const bool is_uhd_codec = video_codec == kSbMediaVideoCodecVp9 ||
-                            video_codec == kSbMediaVideoCodecAv1;
+  // fork: AV1 is hidden unless /tmp/ytaf-av1.enable starts with "1". AV1
+  // through Starfish stalled on the 2021 NanoCell lm21a (lg75, 75NANO756PA):
+  // Play() accepted, no frame ever presented, while VP9 played at 2160p on
+  // the same set (measured 2026-09-06, legacy decoder path). The marker lets
+  // one binary test AV1 per TV; /tmp is cleared on reboot, so a hang falls
+  // back to VP9. Read once so a process never mixes codec answers.
+  static const bool av1_enabled = [] {
+    FILE* marker = fopen("/tmp/ytaf-av1.enable", "r");
+    if (!marker) return false;
+    const int first = fgetc(marker);
+    fclose(marker);
+    return first == '1';
+  }();
+  const bool is_uhd_codec =
+      video_codec == kSbMediaVideoCodecVp9 ||
+      (av1_enabled && video_codec == kSbMediaVideoCodecAv1);
   if (!is_avc && !is_uhd_codec) {
     return false;
   }
