+             // advertise codecs that PlayerComponentsFactory cannot create;
+             // otherwise YouTube selects them and playback fails at startup.
+             video_codec == kSbMediaVideoCodecH264
+#else
+             video_codec == kSbMediaVideoCodecAv1 ||
