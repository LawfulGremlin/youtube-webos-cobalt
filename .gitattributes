# Fork-owned files: always keep our version when merging upstream.
# Requires `git config merge.ours.driver true` on the runner (set in
# .github/workflows/sync-upstream.yml).
.gitattributes merge=ours
FORK.md merge=ours
README.md merge=ours
repo.json merge=ours
.github/workflows/sync-upstream.yml merge=ours
# ci.yml became fork-owned 2026-08: upstream's version now fails if any
# .ipk/.xz is tracked, and committing those binaries is this fork's
# deliberate divergence from upstream's private-images model.
.github/workflows/ci.yml merge=ours
.github/workflows/release.yml merge=ours
.github/workflows/fork-ci.yml merge=ours
tools/gen-repo-json.cjs merge=ours
webapp/src/fork/** merge=ours
